{
  "name": "cafeto-sierra-alta-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node scripts/optimizar-imagenes.mjs",
    "postbuild": "node scripts/limpiar-export.mjs",
    "start": "next start",
    "optimizar-imagenes": "node scripts/optimizar-imagenes.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run --config vitest.config.mts",
    "test:ui": "vitest run --config vitest.ui.config.mts",
    "test:importacion": "node --experimental-sqlite --test scripts/preparar-ventas-octubre.test.mjs",
    "test:costos": "node --experimental-sqlite --test scripts/preparar-costos-cafe.test.mjs",
    "test:export": "node --test scripts/normalizar-export.test.mjs",
    "preparar:octubre": "node scripts/preparar-ventas-octubre.mjs",
    "cf:dev": "wrangler dev --port 8788 --persist-to .wrangler/demo-state",
    "cf:deploy": "wrangler deploy",
    "cf:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run cf:deploy",
    "demo:prepare": "node scripts/preparar-demo.mjs",
    "demo:start": "wrangler dev --port 8788 --persist-to .wrangler/demo-state",
    "demo": "npm run demo:prepare && npm run build -- --webpack && npm run demo:start"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
